rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isAdminOf(institutionId) {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && adminDoc().data.institutionId == institutionId;
    }

    // Each admin can read only their own admin record.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Any signed-in visitor (admin or guest) can read the bank's public profile
    // (name, logo, sender ID) for the preview. Only admins can edit it, and never
    // their own "verified" status.
    match /institutions/{institutionId} {
      allow read: if signedIn();
      allow update: if isAdminOf(institutionId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified']);
      allow create, delete: if false;
    }

    // Registry monitor:
    //  - admins read all of their institution's entries
    //  - guests read only the entries they created themselves (no one else's phone numbers)
    // Only the Cloud Function writes here.
    match /messageRegistry/{hash} {
      allow read: if isAdminOf(resource.data.institutionId)
        || (signedIn() && resource.data.createdByUid == request.auth.uid);
      allow write: if false;
    }

    // Guest rate-limit counters: server only.
    match /guestUsage/{uid} {
      allow read, write: if false;
    }
  }
}

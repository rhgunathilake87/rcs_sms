# Copy to .env.production and fill in from the Firebase console.
VITE_USE_EMULATORS=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_API_BASE=https://asia-south1-<project-id>.cloudfunctions.net/api

# Guest (no-login) demo mode — requires Anonymous sign-in enabled in Firebase Authentication
VITE_GUEST_MODE=true
VITE_GUEST_INSTITUTION_ID=demo-bank

# Android app download: a Google Drive link shared as "Anyone with the link"
VITE_APK_URL=https://drive.google.com/file/d/<FILE_ID>/view?usp=sharing
